NEXT_PUBLIC_API_URL=http://localhost:64837
# Set to /api/v1/payment/hubs/payments to enable PaymentHub through the same-origin proxy.
# Leave empty to keep polling only. NEXT_PUBLIC_* values are supplied at build time.
NEXT_PUBLIC_SIGNALR_HUB_URL=
# Payment API (or Gateway that routes /api/v1/payment/hubs/payments), without the Hub path.
# Configure the actual host/port; no default Payment API port is assumed.
# Used by Next.js rewrites at build time; restart next dev after changing it.
PAYMENT_API_BASE_URL=
NEXT_PUBLIC_MOCK_RENTAL_API=false
# Optional server-side override for Next.js route handlers. In the dev VPS it
# is http://gateway:8080 so browser requests keep using the public API domain.
# BACKEND_API_URL=http://localhost:64837
# Optional canonical public origin for server-side OAuth callbacks. This avoids
# relying on reverse-proxy Host headers in deployed environments.
# FRONTEND_ORIGIN=http://localhost:3000

# Firebase Auth client config for Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
