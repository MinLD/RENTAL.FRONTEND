NEXT_PUBLIC_API_URL=http://localhost:64837
# Optional server-side override for Next.js route handlers. In the dev VPS it
# is http://gateway:8080 so browser requests keep using the public API domain.
# BACKEND_API_URL=http://localhost:64837
# Optional canonical public origin for server-side OAuth callbacks. This avoids
# relying on reverse-proxy Host headers in deployed environments.
# FRONTEND_ORIGIN=http://localhost:3000

# Public equipment detail uses the same mock data for every ID during development.
# Set false to call the real backend. Production always uses the real backend.
MOCK_PUBLIC_EQUIPMENT_DETAIL=true

# Firebase Auth client config for Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
